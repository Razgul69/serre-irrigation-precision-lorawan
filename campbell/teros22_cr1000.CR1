'CR1000 - Acquisition METER TEROS 22 en SDI-12
'La balance est volontairement exclue de ce programme.

Const SDI_ADDR  = 0       'Adresse SDI-12 (0 = valeur usine)
Const SDI_PORT  = 3       'Port SDI-12 : 3 = borne C3 sur CR1000
Const SCAN_S    = 60      'Une mesure par minute
Const TABLE_MIN = 15      'Un enregistrement toutes les 15 minutes

Public PTemp_C
Public Batt_V
Public TEROS22(2)
Public WaterPot_kPa
Public SoilTemp_C

Units PTemp_C = Deg C
Units Batt_V = Volts
Units WaterPot_kPa = kPa
Units SoilTemp_C = Deg C

DataTable(MesuresTEROS22, True, -1)
    DataInterval(0, TABLE_MIN, Min, 10)
    Minimum(1, Batt_V, FP2, False, False)
    Sample(1, PTemp_C, FP2)
    Sample(1, WaterPot_kPa, IEEE4)
    Sample(1, SoilTemp_C, FP2)
EndTable

BeginProg
    Scan(SCAN_S, Sec, 0, 0)
        PanelTemp(PTemp_C, 60)
        Battery(Batt_V)

        'M! lance la mesure puis recupere automatiquement les donnees.
        'TEROS22(1) = potentiel matriciel (kPa)
        'TEROS22(2) = temperature du sol (deg C)
        SDI12Recorder(TEROS22(), SDI_PORT, SDI_ADDR, "M!", 1.0, 0)

        WaterPot_kPa = TEROS22(1)
        SoilTemp_C = TEROS22(2)

        CallTable(MesuresTEROS22)
    NextScan
EndProg