    {
        "id": "aa11bb22cc33dd44",
        "type": "function",
        "z": "6daaab707e05e63b",
        "name": "Format TTN downlink",
        "func": "// Formater la commande d ouverture pour TTN\nvar cmd = msg.payload; // \"1\" = ouverture, \"0\" = fermeture\n\n// Encoder en base64 pour TTN frm_payload\nvar b64 = Buffer.from(cmd, 'utf8').toString('base64');\n\nmsg.payload = JSON.stringify({\n    downlinks: [{\n        f_port: 1,\n        frm_payload: b64,\n        priority: \"NORMAL\"\n    }]\n});\n\nnode.status({fill:\"green\", shape:\"dot\", text:\"Commande: \" + cmd});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
