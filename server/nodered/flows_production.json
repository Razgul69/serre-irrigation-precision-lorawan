    {
        "id": "func_matric_01",
        "type": "function",
        "z": "6daaab707e05e63b",
        "name": "Parse TTN  InfluxDB",
        "func": "// Parser le payload JSON TTN\nvar payload = msg.payload;\nif (typeof payload === \"string\") {\n    try { payload = JSON.parse(payload); } catch(e) { return null; }\n}\n\nvar uplink = payload.uplink_message;\nif (!uplink) return null;\n\nvar decoded = uplink.decoded_payload;\nvar deviceId = (payload.end_device_ids || {}).device_id || msg.topic;\n\n// Extraire les champs numeriques du payload decode TTN\nvar fields = {};\nif (decoded) {\n    for (var key in decoded) {\n        var val = decoded[key];\n        if (typeof val === \"number\") { fields[key] = val; }\n    }\n}\nif (Object.keys(fields).length === 0) return null;\n\n// Format correct pour node-red-contrib-influxdb 0.7 : [fields, tags]\nmsg.payload = [fields, { device: deviceId }];\n\nnode.status({fill:\"green\", shape:\"dot\", text: \"OK - \" + Object.keys(fields).join(\", \")});\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 480,
        "wires": [
            [
                "influx_out_01"
            ]
        ]
    },
